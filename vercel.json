{
  "crons": [
    {
      "path": "/api/cron-runner?job=daily-report",
      "schedule": "0 22 * * *"
    }
  ],
  "functions": {
    "api/og-image.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/ai-planner-full.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/ai-planner-quick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/booking-processor.js": {
      "maxDuration": 120
    },
    "api/cron-runner.js": {
      "maxDuration": 120
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cocotripkr.com" }],
      "destination": "https://cocotripkr.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}