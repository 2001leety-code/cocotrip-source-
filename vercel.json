{
  "functions": {
    "api/ai-planner-full.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/ai-planner-quick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/booking-processor.js": {
      "maxDuration": 120
    },
    "api/cron-runner.js": {
      "maxDuration": 120
    },
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}