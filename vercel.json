{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron-runner?job=daily-report",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-runner?job=refund-reminder",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron-runner?job=dispatch-timeout-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=weekly-quality-report",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron-runner?job=dispatch-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-runner?job=dispatch-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-runner?job=operator-todo-reminder",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-runner?job=processor-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=email-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=ai-planner-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=slot-pending-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=scan-naver-rising",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron-runner?job=scan-reddit-painpoints",
      "schedule": "0 19 * * 1"
    },
    {
      "path": "/api/cron-runner?job=scan-visitkorea-attractions",
      "schedule": "0 20 1 * *"
    },
    {
      "path": "/api/cron-runner?job=intent-classifier-summary",
      "schedule": "0 21 * * 1"
    }
  ],
  "functions": {
    "api/og-image.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/ai-planner-full.js": {
      "maxDuration": 300,
      "memory": 768
    },
    "api/ai-planner-quick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/booking-processor.js": {
      "maxDuration": 60
    },
    "api/cron-runner.js": {
      "maxDuration": 60
    },
    "api/pdf/generate.js": {
      "maxDuration": 60,
      "includeFiles": "fonts/**"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cocotripkr.com" }],
      "destination": "https://cocotripkr.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
