{
  "ignoreCommand": "git log -1 --pretty=%B | grep -qiE '\\[skip ci\\]|\\[skip vercel\\]|\\[no deploy\\]|^WIP' && exit 0 || (git diff --name-only HEAD^ HEAD | grep -qvE '^(docs/|\\.github/|\\.agent/|tests/|.+\\.md$)' && exit 1 || exit 0)",
  "crons": [
    {
      "path": "/api/cron-runner?job=daily-report",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-runner?job=refund-reminder",
      "schedule": "0 23 * * *"
    }
  ],
  "functions": {
    "api/og-image.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/ai-planner-full.js": {
      "maxDuration": 300,
      "memory": 768
    },
    "api/ai-planner-quick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/booking-processor.js": {
      "maxDuration": 60
    },
    "api/cron-runner.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cocotripkr.com" }],
      "destination": "https://cocotripkr.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
