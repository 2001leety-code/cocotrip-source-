{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "crons": [
    {
      "path": "/api/cron-runner?job=daily-report",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-runner?job=refund-reminder",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron-runner?job=dispatch-timeout-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=weekly-quality-report",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron-runner?job=dispatch-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-runner?job=dispatch-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-runner?job=operator-todo-reminder",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-runner?job=processor-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=email-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=inquiry-response-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=ai-planner-retry-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=slot-pending-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=plan-streaming-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-runner?job=scan-naver-rising",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron-runner?job=scan-reddit-painpoints",
      "schedule": "0 19 * * 1"
    },
    {
      "path": "/api/cron-runner?job=scan-visitkorea-attractions",
      "schedule": "0 20 1 * *"
    },
    {
      "path": "/api/cron-runner?job=intent-classifier-summary",
      "schedule": "0 21 * * 1"
    },
    {
      "path": "/api/cron-runner?job=morning-briefing",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/cron-runner?job=review-request",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron-runner?job=content-draft",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron-runner?job=ops-watchdog",
      "schedule": "45 23 * * *"
    },
    {
      "path": "/api/cron-runner?job=kpop-calendar-check",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron-runner?job=preview-lead-recovery",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/og-image.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/ai-planner-full.js": {
      "maxDuration": 800,
      "memory": 768
    },
    "api/ai-planner-quick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/booking-processor.js": {
      "maxDuration": 60
    },
    "api/cron-runner.js": {
      "maxDuration": 60,
      "includeFiles": "src/data/kpopConcerts.json"
    },
    "api/social-media-upload.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/course-ai.js": {
      "maxDuration": 30,
      "includeFiles": "api/{_attractions_index,_food_index}.json"
    },
    "api/pdf/generate.js": {
      "maxDuration": 60,
      "includeFiles": "fonts/**"
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/api/place-photo",
      "destination": "/brand/icon.svg",
      "permanent": true
    },
    {
      "source": "/guide/4-seoul-cafe-neighborhoods-worth-your",
      "destination": "https://cocotripkr.com/guide/seoul-cafe-guide-2026-best",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cocotripkr.com" }],
      "destination": "https://cocotripkr.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/social-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/(mypage|my-plans|mood|admin|map|assistant|s|cart|charter-new|charter-legacy|booking|preview|dev|community|links|account-deletion)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/meta-oauth-callback/",
      "destination": "/api/meta-oauth-callback"
    },
    {
      "source": "/api/tiktok-oauth-callback/",
      "destination": "/api/tiktok-oauth-callback"
    },
    {
      "source": "/api/threads-oauth-callback/",
      "destination": "/api/threads-oauth-callback"
    },
    { "source": "/planstest", "destination": "/api/planstest" },
    {
      "source": "/blog-images/:year/:name",
      "destination": "/api/blog-image?year=:year&name=:name"
    },
    {
      "source": "/social-media/:id([a-f0-9]{48}).jpg",
      "destination": "https://firebasestorage.googleapis.com/v0/b/planning-with-ai-a0801.firebasestorage.app/o/social-media-:id.jpg?alt=media"
    },
    {
      "source": "/social-media/:id([a-f0-9]{48}).mp4",
      "destination": "https://firebasestorage.googleapis.com/v0/b/planning-with-ai-a0801.firebasestorage.app/o/social-media-:id.mp4?alt=media"
    },
    { "source": "/", "destination": "/index.html" },
    {
      "source": "/(about|terms|privacy|account-deletion|travel-terms|tours|planner|charter|charter-new|charter-legacy|booking|map|assistant|cart|mypage|links)",
      "destination": "/index.html"
    },
    {
      "source": "/(tours|region|guide|s|my-plans|community|mood|admin|preview|dev)(/.*)?",
      "destination": "/index.html"
    },
    { "source": "/((?!api/).*)", "destination": "/api/not-found" }
  ]
}
