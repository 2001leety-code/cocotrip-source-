# .claudeignore — CocoTrip
# Claude가 읽지 않을 파일/폴더 (.gitignore 문법)

# 빌드 산출물
node_modules/
.next/
dist/
build/
out/

# 로그·캐시
*.log
.cache/
coverage/
.turbo/

# 환경변수 (보안)
.env
.env.local
.env.development.local
.env.production.local

# Vercel·Firebase 배포 산출물
.vercel/
.firebase/
firebase-debug.log

# 소스맵 (디버깅 전용)
*.map

# 에디터·OS
.vscode/
.idea/
*.DS_Store

# food data 백업 (대용량, 운영 무관)
food_data/*.backup.json
