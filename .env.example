# CocoTrip 환경 변수 — Vercel Project Settings 또는 .env.local 에 채워서 사용.
# 운영 런북: docs/plans/operations-runbook.md

# ── Backend (Vercel Serverless / Node) ────────────────────────────
# AI 플래너 (필수)
GEMINI_API_KEY=

# Firebase Admin SDK (Firestore 쓰기) — base64로 인코딩한 service account JSON
GOOGLE_SERVICE_ACCOUNT_KEY=

# Brain → 소셜 미디어 원본 업로드 전용 Bearer 키 (최소 32자, 서버 전용)
# Vercel Production 환경과 Brain 로컬 .env 에 같은 값을 넣는다.
# VITE_ 접두사를 붙이면 브라우저 번들에 노출되므로 절대 금지.
SOCIAL_MEDIA_UPLOAD_TOKEN=

# PayPal (운영)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal (샌드박스 — TEST_ACCOUNTS bypass 용도)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
# P314 (2026-05-30): sandbox e2e 토글 — ⚠️ Vercel "Preview" 환경에만 등록 (Production 금지!)
#   PAYPAL_ENV=sandbox        (백엔드 resolveIsSandbox — VERCEL_ENV!=='production' AND 이 값=sandbox 일 때만 sandbox)
#   VITE_PAYPAL_ENV=sandbox   (프론트 SDK — preview 빌드만 sandbox client-id 로드)
#   VITE_PAYPAL_SANDBOX_CLIENT_ID=  (PAYPAL_SANDBOX_CLIENT_ID 와 동일 값)
# prod 안전: VERCEL_ENV='production'(Vercel 주입) 이면 PAYPAL_ENV 무관 무조건 live.

# 📌 결제 우회용 env var 는 존재하지 않는다 (2026-07-20 기준).
#   'TEST-' prefix orderId 로 결제 검증을 건너뛰던 경로가 있었고 BRAINTREE_ENV 로 열렸으나,
#   (1) 프론트가 2026-05-07 부터 안 보내고 (2) 그 env 는 Vercel 에 등록된 적이 없어 이미
#   상시 403 이었으며 (3) admin 검사가 없어 env 만 잘못 켜면 아무 로그인 계정이나 유료 플랜을
#   받을 수 있었다 → 경로 자체를 제거했다. BRAINTREE_ENV / PAYMENT_BYPASS_ENV 둘 다 넣지 말 것.
#   결제 없이 플랜을 만들어야 하면 ADMIN-BYPASS- prefix (admin 이메일 + ID token 이중 검증) 사용.

# Telegram 운영 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 고객 확인 이메일 (Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 고객문의 초안 워커 — Vercel Production 환경변수에 true 등록할 때만 동작.
INQUIRY_RESPONSE_WORKER_ENABLED=false
# 한 번에 처리할 문의 수(1~5, 기본 3)
INQUIRY_RESPONSE_BATCH_SIZE=3
# 결정론 정책 템플릿 자동 접수 확인 — worker와 이 값이 모두 true여야 동작.
# 실제 견적·금액은 보내지 않으며, 로그인 이메일이 문의 이메일과 일치한 경우만 허용한다.
INQUIRY_RESPONSE_AUTO_ACK_ENABLED=false
# 반드시 UTC 밀리초까지 포함한 정확한 형식: YYYY-MM-DDTHH:mm:ss.sssZ
INQUIRY_RESPONSE_AUTO_ACK_NOT_BEFORE=
# 접수 후 이 시간이 지난 문의는 뒤늦게 자동발송하지 않는다(5~1440분).
INQUIRY_RESPONSE_AUTO_ACK_MAX_AGE_MINUTES=30
# 하루 전체 자동 접수 메일 상한(1~100). 같은 이메일은 하루 1회만 허용한다.
INQUIRY_RESPONSE_AUTO_ACK_DAILY_CAP=20
# 위 값 외에도 어드민 런타임 스위치 '문의 자동 접수확인'이 켜져야 발송한다.

# Google Sheets 마스터 시트 ID (booking 자동 기록)
GOOGLE_SHEETS_BOOKINGS_ID=

# Naver Maps (주소 → 좌표) + ODsay (대중교통)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ODSAY_API_KEY=

# CocoTrip 프로덕션 webhook (예약 확정 외부 hook)
COCOTRIP_WEBHOOK_URL=

# Planner 모드 — 'legacy' 또는 '3pass'
PLANNER_MODE=legacy

# Web Push (VAPID) — `npx web-push generate-vapid-keys`로 발급
# 프론트엔드는 VITE_VAPID_PUBLIC_KEY로 동일 값 노출 (공개 가능)
# 서버 발송용 비밀 키. 절대 클라이언트에 노출 금지.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@cocotripkr.com

# Sentry server-side DSN (백엔드 unhandled error → Sentry 대시보드)
# 미설정 시 api/_shared/sentry.js 가 no-op (개발/테스트 환경 무영향)
SENTRY_DSN=

# ── Frontend (Vite — VITE_ prefix만 client-side 노출) ──────────────
# 외부 평점은 internal 자체 집계만 사용한다.
# Google Places 키를 VITE_ 변수로 추가하지 말 것 — 브라우저 노출 + 무제한 과금 경로가 된다.

# Web Push 공개 키 (위 VAPID_PUBLIC_KEY와 동일 값. 클라이언트 subscribe()용)
VITE_VAPID_PUBLIC_KEY=

# Sentry (에러 추적, 선택)
VITE_SENTRY_DSN=

# ── Affiliate Programs (Wrap-up + 광고 슬라이드) ────────────────
# 2026-05-08 추가. 미설정 시 단순 fallback 링크로 동작 (매출 0).
# 운영자가 각 프로그램 가입 후 발급받은 ID 를 등록.
#
# Airalo Affiliate Program — https://www.airalo.com/affiliate-program
VITE_AIRALO_AFFILIATE_ID=
# Yesim Affiliate (https://yesim.app/ 문의)
VITE_YESIM_AFFILIATE_ID=
# Trip.com Affiliate Partners — https://www.trip.com/partners/affiliate
# 기본값(미설정 시): Allianceid=4831212 / SID=76964637 (운영자 본 계정)
VITE_TRIPCOM_AFFILIATE_ID=
VITE_TRIPCOM_SID=
# trip_sub1 트래킹 (선택, 기본 'cocotrip')
VITE_TRIPCOM_SUB1=
