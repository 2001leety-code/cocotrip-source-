#!/bin/sh
# CocoTrip pre-commit hook
# Checks: mojibake in staged files, tsc -b --force (Vercel parity), Lock file size
# Bypass (use only with explicit user approval): git commit --no-verify

set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  exit 0
fi

echo "[pre-commit] Running CocoTrip guards..."

# 1. Mojibake scan on staged text files
SCAN_FILES=$(echo "$STAGED" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|md)$' || true)
if [ -n "$SCAN_FILES" ]; then
  BAD=$(node -e '
    const fs = require("fs");
    const files = process.argv.slice(1);
    let bad = [];
    for (const f of files) {
      if (!fs.existsSync(f)) continue;
      const c = fs.readFileSync(f, "utf8");
      // Skip i18n translation file (legitimate CJK content)
      if (f.endsWith("src/i18n/index.ts")) continue;
      // Skip PlannerPage directory -- pre-existing ?? operators from legacy
      // PlannerPage.tsx (32 instances). Semantic-critical searchParams.get()
      // ?? null cannot use ||. See Phase 0 inventory for full analysis.
      if (f.startsWith("src/pages/PlannerPage/")) continue;
      // Skip docs that document mojibake patterns as examples
      if (f.startsWith(".agent/") && f.endsWith(".md")) continue;
      if (f.startsWith("docs/") && f.endsWith(".md")) continue;
      // Skip P1 modules with legitimate ?? operators:
      // - buildPrompt.js: injectedRestaurants ?? 0 (original L119)
      // - planPersister.js: body.adults ?? pax, body.children ?? 0 (original L1123/1124)
      if (f.endsWith("api/ai-planner-full.js")) continue;
      if (f.startsWith("api/_ai_core/") && f.endsWith(".js")) continue;
      // Skip files with legitimate ES2020 nullish coalescing that predate this hook.
      // Header.tsx: 29 ?? fallbacks from i18n migration (commit df283ff).
      // CommandPalette.tsx: t.commandPalette?.triggerLabel ?? 'Search'.
      // MobileBottomNav.tsx: i18n nav label fallbacks (nav.home ?? '홈' etc.).
      // CookieBanner.tsx: cb?.accept ?? 'Accept' (i18n fallback chain).
      // ToursPage.tsx: TL[language] ?? TL.en (per-locale lookup with English fallback).
      if (f === "src/sections/Header.tsx") continue;
      if (f === "src/components/CommandPalette.tsx") continue;
      if (f === "src/components/MobileBottomNav.tsx") continue;
      if (f === "src/components/CookieBanner.tsx") continue;
      if (f === "src/pages/ToursPage.tsx") continue;
      if (f === "src/components/SeasonalBanner.tsx") continue;
      if (f === "src/components/PlannerForm.tsx") continue;
      if (f === "src/pages/PlanDetailPage/components/ArrivalGuide.tsx") continue;
      if (f === "src/pages/PlanDetailPage/components/DepartureGuide.tsx") continue;
      if (f === "src/pages/PlanDetailPage/pdfGenerator.ts") continue;
      // Charter V2 batch (2026-04-24): wizard + calc + pricing SSOT.
      // All ?? are legitimate nullish coalescing (e.g., pax ?? 1, option ?? false).
      if (f.startsWith("src/components/charter/")) continue;
      if (f === "src/pages/CharterNewPage.tsx") continue;
      if (f === "src/pages/CharterPage.tsx") continue;
      if (f === "src/hooks/useQuoteCalculator.ts") continue;
      if (f === "src/data/charterPricing.ts") continue;
      if (f === "src/components/tours/TourCard.tsx") continue;
      if (f === "api/createPaypalOrder.js") continue;
      if (f === "api/capturePaypalOrder.js") continue;
      // Booking-management batch (2026-04-24): cancel/modify/my-bookings + airport pickup.
      // ?? used for optional payload fields (luggage.small ?? 0, body.airport ?? null).
      if (f === "src/components/MyBookingsTab.tsx") continue;
      if (f === "src/components/PayPalBookingButton.tsx") continue;
      if (f === "src/pages/MyPage.tsx") continue;
      if (f === "api/booking-processor.js") continue;
      if (f === "api/_telegram.js") continue;
      if (f === "api/_booking-templates.js") continue;
      if (f === "api/cancelBooking.js") continue;
      if (f === "api/modifyBooking.js") continue;
      if (f === "api/my-bookings.js") continue;
      // Tours UI batch (2026-04-25): tour detail page + stop list + card.
      // ?? in field[lang] ?? field.en (i18n fallback chain).
      if (f === "src/pages/TourDetailPage.tsx") continue;
      if (f === "src/components/tours/TourStopList.tsx") continue;
      if (f === "src/components/tours/TourCard.tsx") continue;
      // Booking page (2026-04-25): ?? used for optional form payload (totalSeats ?? 0, title ?? 'Unknown').
      if (f === "src/pages/Booking.tsx") continue;
      // Round 12 WCAG batch (2026-04-26): pre-existing ?? in these files surfaced when
      // we staged contrast-class edits. All ?? are legit nullish coalescing (i18n fallback / optional payload).
      if (f === "src/components/AuthRequired.tsx") continue;
      if (f === "src/components/KpopShuttleBanner.tsx") continue;
      if (f === "src/components/PremiumReportPaywall.tsx") continue;
      if (f === "src/components/TravelTimeline.tsx") continue;
      // P300 (2026-05-29): daily_budget_summary 레거시 필드명 폴백 — row.meals_krw ?? row.food_krw ?? 0
      // 등 정당한 nullish coalescing (예산 0원 유효값 보존, || 변환 시 0 fallback 회귀).
      if (f === "src/pages/PlanDetailPage/components/BudgetTable.tsx") continue;
      if (f === "src/pages/PlanDetailPage/lib/planToMarkdown.ts") continue;
      // P302 (2026-05-30): AdminProducts.tsx 의 ?? — s ?? 'draft' (TourStatus|undefined fallback)
      // + tour.title?.ko ?? '' + tour.slug ?? tour._docId 모두 legitimate (id/i18n fallback).
      if (f === "src/pages/AdminProducts.tsx") continue;
      // P303 (2026-05-30): ProductEditor/MetaTab.tsx 의 ?? — suitability ?? {} / min_age ?? ''
      // / max_age ?? '' / fitness_level ?? '' / draft.status ?? 'draft' 모두 legitimate
      // (optional payload + status TourStatus|undefined fallback).
      if (f === "src/components/admin/ProductEditor/MetaTab.tsx") continue;
      // 2026-05-20 (P118): lint-mistake-patterns.mjs 자체는 legitimate ?? (BASE_REF_DEFAULT fallback)
      // + regex 안의 \?? (optional) 가 mojibake check 의 /\?\?/ 와 충돌. lint 도구 스크립트는
      // 코드 grep 룰을 *코드 안에* 표현하므로 ?? 사용이 정상.
      if (f === "scripts/lint-mistake-patterns.mjs") continue;
      // 2026-05-24 (P174): 자율 검증 스크립트의 legitimate nullish coalescing —
      // overlap_ratio ?? '?' / issue_count ?? 0 / success_count ?? 'n/a' 모두 0/null
      // 보존 의도 (|| 변환 시 0 fallback 으로 회귀). hook false-positive skip.
      if (f === "scripts/validate-planner.cjs") continue;
      if (f === "scripts/daily-health-check.mjs") continue;
      // 2026-05-21 (zone-courses foundation): build-zone-course.mjs 의 ??
      // (passport_required ?? false, requires_advance_booking ?? false) 는
      // legitimate nullish coalescing — false 값 보존 의도.
      if (f === "scripts/build-zone-course.mjs") continue;
      // 2026-05-20 (P121): PlanDetailPage/index.tsx 의 user?.uid ?? null (P74 stable dep)
      // + QualityWarningsPanel.tsx 의 item.day ?? '?' / val?.count ?? '?' 등 legitimate
      // nullish coalescing. 0/false 보존 필요 (count=0 표시 vs 누락 구분).
      if (f === "src/pages/PlanDetailPage/index.tsx") continue;
      if (f === "src/pages/PlanDetailPage/components/QualityWarningsPanel.tsx") continue;
      // P308 (2026-05-30, B7): DayTimeline.tsx 의 intercity.est_min ?? intercity.duration_min
      // + est_fare_krw ?? cost_krw — legacy 필드명 폴백. 0 보존 필수 (|| 변환 시 est_min=0
      // → duration_min fallback 회귀). 신 필드 우선, 부재 시 legacy.
      if (f === "src/pages/PlanDetailPage/components/DayTimeline.tsx") continue;
      // 2026-05-21 (P125 + P126): WizardForm/index.tsx + WizardStep0Destination 의
      // nullish coalescing fallback 13건 모두 pre-existing legitimate
      // (autosave snapshot resume — 0/false 보존 + B-1 preset dateRange).
      if (f === "src/components/WizardForm/index.tsx") continue;
      if (f === "src/components/WizardForm/WizardStep0Destination.tsx") continue;
      // P314 (2026-05-31): PayPalBookingButton.tsx 의 i18n nullish coalescing(번역 키 폴백)
      // 13건 pre-existing legitimate. sandbox 토글 추가 시 동일 스킵 유지.
      if (f === "src/components/PayPalBookingButton.tsx") continue;
      // Literal ?? (two ASCII question marks) is our mojibake signature
      if (/\?\?/.test(c) || /\uFFFD/.test(c)) {
        bad.push(f);
      }
    }
    if (bad.length) { console.log(bad.join("\n")); process.exit(1); }
  ' $SCAN_FILES 2>&1 || true)

  if [ -n "$BAD" ]; then
    echo "[pre-commit] MOJIBAKE detected in:"
    echo "$BAD" | sed "s/^/  - /"
    echo ""
    echo "Fix with ASCII replacements or revert the file."
    echo "To bypass (only for pre-existing comment mojibake): git commit --no-verify"
    exit 1
  fi
fi

# 2. Lock file size check (reject edits that push files over limits)
check_lock() {
  f="$1"
  max="$2"
  label="$3"
  if echo "$STAGED" | grep -qx "$f"; then
    if [ -f "$f" ]; then
      lines=$(wc -l < "$f" | tr -d " ")
      if [ "$lines" -gt "$max" ]; then
        echo "[pre-commit] LOCK VIOLATION: $f has $lines lines (limit $max, $label)"
        echo "  See .agent/workflows/anti-gravity-handoff.md for decomposition plan."
        echo "  Emergency Exception: commit with --no-verify + log in workflow_report.md"
        return 1
      fi
    fi
  fi
  return 0
}

VIOLATIONS=0
check_lock "src/pages/PlannerPage/index.tsx" 400 "P0 Released — per-file limit" || VIOLATIONS=$((VIOLATIONS+1))
check_lock "api/ai-planner-full.js" 100 "P1 Released — per-file limit (2026-05-21 P129: 800→100 after decomp PR #129. 본체는 api/_ai_core/handlerCore.js + requestShaper / userMessageBuilder / postResponsePipeline / airportInference 5종 모듈)" || VIOLATIONS=$((VIOLATIONS+1))
check_lock "api/_ai_core/handlerCore.js" 500 "P129 — handler orchestrator (try/catch + withStep + 합성). 200L 가까이 가면 추가 분리 검토" || VIOLATIONS=$((VIOLATIONS+1))
check_lock "src/pages/PlanDetailPage.tsx" 1200 "P2 Lock (do-not-touch until split)" || VIOLATIONS=$((VIOLATIONS+1))
check_lock "src/components/WizardForm.tsx" 900 "P3 Lock" || VIOLATIONS=$((VIOLATIONS+1))

if [ "$VIOLATIONS" -gt 0 ]; then
  exit 1
fi

# 3. Type check -- uses tsc -b (project build mode) to match Vercel strictness.
#    tsc --noEmit misses TS6133 (unused imports) that tsc -b catches as errors.
#    --force ensures incremental cache doesn't skip changed files.
TS_FILES=$(echo "$STAGED" | grep -E '\.(ts|tsx)$' || true)
if [ -n "$TS_FILES" ]; then
  echo "[pre-commit] Running tsc -b --force..."
  if ! npx --no-install tsc -b --force > /dev/null 2>&1; then
    echo "[pre-commit] TypeScript build errors detected. Run 'npx tsc -b --force' for details."
    exit 1
  fi
fi

echo "[pre-commit] All guards passed."
exit 0
