{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:iphone": "playwright test --project='iPhone 14 Pro'",
    "test:e2e:android": "playwright test --project='Pixel 7'",
    "test:e2e:desktop": "playwright test --project='Desktop Chrome'",
    "test:e2e:report": "playwright show-report tests/report",
    "check:types": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-parity.cjs",
    "check:mojibake": "node -e \"const fs=require('fs');const files=process.argv.slice(1).filter(f=>f.endsWith('.tsx')||f.endsWith('.ts'));let bad=0;files.forEach(f=>{if(!fs.existsSync(f))return;const c=fs.readFileSync(f,'utf8');if(/\\\\?\\\\?/.test(c)||/\\uFFFD/.test(c)){console.error('MOJIBAKE in',f);bad++;}});process.exit(bad>0?1:0);\" src/pages/*.tsx",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "check:size": "size-limit",
    "verify:all": "npm run check:types && npm run check:mojibake && npm run test:unit",
    "audit:ux": "node scripts/audit-ux.mjs http://localhost:5173",
    "audit:ux:quick": "node scripts/audit-ux.mjs http://localhost:5173 --quick",
    "audit:ux:prod": "node scripts/audit-ux.mjs https://cocotripkr.com"
  },
  "dependencies": {
