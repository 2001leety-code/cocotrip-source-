    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.68.0",
    "@sentry/react": "^10.68.0",
    "@sparticuz/chromium": "^147.0.2",
    "@types/qrcode": "^1.5.6",
