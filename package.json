    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "inngest": "4.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "posthog-js": "^1.407.2",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
