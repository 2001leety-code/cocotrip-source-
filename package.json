{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:iphone": "playwright test --project='iPhone 14 Pro'",
    "test:e2e:android": "playwright test --project='Pixel 7'",
    "test:e2e:desktop": "playwright test --project='Desktop Chrome'",
    "test:e2e:report": "playwright show-report tests/report",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:report": "playwright show-report tests/visual-report",
    "check:types": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-parity.cjs",
    "check:mojibake": "node -e \"const fs=require('fs');const files=process.argv.slice(1).filter(f=>f.endsWith('.tsx')||f.endsWith('.ts'));let bad=0;files.forEach(f=>{if(!fs.existsSync(f))return;const c=fs.readFileSync(f,'utf8');if(/\\\\?\\\\?/.test(c)||/\\uFFFD/.test(c)){console.error('MOJIBAKE in',f);bad++;}});process.exit(bad>0?1:0);\" src/pages/*.tsx",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "mood:smoke": "node scripts/mood-smoke.mjs",
    "check:size": "size-limit",
    "verify:all": "npm run check:types && npm run check:mojibake && npm run test:unit",
    "verify:prepush": "npm run build && npx vitest run && npx size-limit && node scripts/lint-mistake-patterns.mjs origin/main",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "audit:ux": "node scripts/audit-ux.mjs http://localhost:5173",
    "audit:ux:quick": "node scripts/audit-ux.mjs http://localhost:5173 --quick",
    "audit:ux:prod": "node scripts/audit-ux.mjs https://cocotripkr.com",
    "plan:test": "node scripts/plan-local/run.mjs",
    "plan:record": "node scripts/plan-local/record.mjs"
  },
  "overrides": {
    "qs": "^6.15.3",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.9.16"
    },
    "google-gax": {
      "@grpc/grpc-js": "^1.14.4"
    },
    "@opentelemetry/core": "^2.9.0",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
