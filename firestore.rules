rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // Helper functions
    // ─────────────────────────────────────────────────────────
    function isSignedIn()    { return request.auth != null; }
    function isOwner(uid)    { return isSignedIn() && request.auth.uid == uid; }
    function isAdminEmail()  { return isSignedIn() && request.auth.token.email == '2001leety@gmail.com'; }

    // ─────────────────────────────────────────────────────────
    // plans — AI 플래너 결과 (공개/비공개)
    //   read:   비로그인 허용 (uid==null or isPublic==true), 로그인 소유자
    //   update: 소유자만 (isPublic 토글, 플랜 편집). uid 변경 금지.
    //   create/delete: 서버 전용 (Admin SDK 우회)
    // ─────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if resource.data.uid == null
               || resource.data.isPublic == true
               || (request.auth != null && resource.data.uid == request.auth.uid);

      // PR #420 (audit H20): 이전엔 uid 외 어느 필드든 update 가능 → user 가
      // quality.score / priceKRW / vehicle 등 server-computed 값 조작 가능.
      // 이제 사용자 control 가능한 필드 (isPublic, title 수정, memo) 만 허용.
      allow update: if request.auth != null
                 && resource.data.uid == request.auth.uid
                 && request.resource.data.uid == resource.data.uid
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'isPublic', 'title', 'tourTitle', 'memo',
                        'lastViewedAt', 'updatedAt',
                      ]);

      allow create, delete: if false;

      // Translation cache — owner can read/write, public plans allow read
      match /translations/{lang} {
        allow read: if request.auth != null
                 && get(/databases/$(database)/documents/plans/$(planId)).data.uid == request.auth.uid;
        allow write: if request.auth != null
                  && get(/databases/$(database)/documents/plans/$(planId)).data.uid == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────────────
    // push_subscriptions/{uid}_{subId} — Web Push subscription
    //   read/write: 본인 uid가 prefix로 일치할 때만
    //   서버(admin SDK)는 룰 우회로 자유 접근
    // ─────────────────────────────────────────────────────────
    match /push_subscriptions/{docId} {
      allow read, write, delete: if isSignedIn()
                              && docId.matches(request.auth.uid + '_.*')
                              && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────
    // users/{uid} — 본인만
    //
    // PR #420 (WC9): 이전엔 read/write 무제한 → 본인이 tier='Platinum' /
    // tripCoins=999999 / totalSpentUSD=999999 직접 조작 가능. 이제 field
    // allowlist 로 sensitive 필드 (loyalty/financial) 잠금.
    //
    // 허용 필드:
    //   create — sign-up 흐름 (saveUserToFirestore in src/lib/firebase.js).
    //            tier='Bronze' / tripCoins=0 / totalSpentUSD=0 / bookingCount=0
    //            기본값 강제. 그 외 default 변조 차단.
    //   update — 프로필 (displayName/photoURL/phoneNumber/needsOnboarding/name/
    //            email/role/lastLoginAt). tier/tripCoins/totalSpentUSD/
    //            bookingCount/createdAt 등 server-managed 필드 제외.
    // ─────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);

      // 신규 가입 — saveUserToFirestore() 호출. 기본값 강제 검증.
      allow create: if isOwner(uid)
                 && request.resource.data.tier == 'Bronze'
                 && request.resource.data.tripCoins == 0
                 && request.resource.data.totalSpentUSD == 0
                 && request.resource.data.bookingCount == 0;

      // 프로필 업데이트 — sensitive 필드 (tier/tripCoins/totalSpentUSD/
      // bookingCount/createdAt) 변경 차단. 서버 SDK 가 loyalty.js 등에서
      // rules 우회로 정상 갱신.
      allow update: if isOwner(uid)
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'displayName', 'photoURL', 'phoneNumber',
                        'needsOnboarding', 'name', 'email', 'role',
                        'lastLoginAt', 'uid',
                      ]);

      allow delete: if false;

      // 저장된 플랜 참조 (planPersister가 서버에서 생성)
      match /plans/{planId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // 포인트 이력 (loyalty API가 서버에서 기록)
      match /pointHistory/{docId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // 쿠폰 (loyalty API가 서버에서 발급/소진)
      match /coupons/{couponId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // 클라이언트 관리 리스트
      match /wishlist/{itemId}        { allow read, write: if isOwner(uid); }
      match /recentlyViewed/{itemId}  { allow read, write: if isOwner(uid); }
      match /itineraries/{itineraryId}{ allow read, write: if isOwner(uid); }

      // 공유 리워드 기록 (loyalty API가 서버에서 기록)
      match /shareRewards/{planId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }

      // 리뷰 리워드 기록 (reviews API가 서버에서 기록)
      match /reviewRewards/{reviewId} {
        allow read:  if isOwner(uid);
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // tours — 공개 카탈로그, 어드민 관리
    //   read:   전체 공개 (비로그인 카탈로그 조회)
    //   update: 어드민(수동 편집) 또는 로그인 사용자 — but only the
    //           `currentBookings` counter (PR #420 / WC7: 예전엔 어느 필드든
    //           수정 가능 → 카탈로그 변조 risk).
    //   create/delete: 어드민만
    // ─────────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read:   if true;
      // PR #420 (WC7): 비-어드민은 currentBookings 증감만 허용. 그 외 필드
      // (price, name, capacity 등) 는 catalog tampering 위험.
      allow update: if isAdminEmail()
                 || (isSignedIn()
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['currentBookings', 'updatedAt']));
      allow create, delete: if isAdminEmail();

      // 예약 레코드 — 본인 것만 생성/열람.
      // PR #420 (WC8): 이전엔 status='CONFIRMED' / amountUSD=0 가짜 가능 →
      // 결제 안 한 user 가 예약 레코드만 만들어 confirmation 발급 attack.
      // 이제 status='pending' 강제 + amountUSD > 0 검증.
      match /bookings/{bookingId} {
        allow read:   if isSignedIn()
                   && (resource.data.userId == request.auth.uid || isAdminEmail());
        allow create: if isSignedIn()
                   && request.resource.data.userId == request.auth.uid
                   && request.resource.data.status == 'pending'
                   && request.resource.data.amountUSD is number
                   && request.resource.data.amountUSD > 0;
        allow update, delete: if isAdminEmail();
      }
    }

    // ─────────────────────────────────────────────────────────
    // earlybird — 공개 카운터
    // ─────────────────────────────────────────────────────────
    match /earlybird/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // reviews — 사용자 리뷰 (공개 읽기, 인증 작성)
    // ─────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.keys().hasAll(['authorUid', 'rating', 'text', 'tourSlug']);
      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 500;
      allow delete: if isSignedIn()
                    && (resource.data.authorUid == request.auth.uid || isAdminEmail());
    }

    // ─────────────────────────────────────────────────────────
    // charter_inquiries — Plan 페이지에서 "전세차량 견적 요청" (인앱)
    //   create: 누구나 (이메일+요청정보 제출)
    //   read:   본인(이메일 매칭) 또는 어드민
    //   update/delete: 어드민만
    // ─────────────────────────────────────────────────────────
    match /charter_inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 200;
      allow read:   if isAdminEmail()
                    || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // pending_free_claims — "이미 예약했어요 → 무료 플랜" 신청
    //   create: 누구나 (이메일+예약정보 제출)
    //   read:   본인(이메일 매칭) 또는 어드민
    //   update/delete: 어드민만 (승인/거부)
    // ─────────────────────────────────────────────────────────
    match /pending_free_claims/{claimId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 200;
      allow read:   if isAdminEmail()
                    || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // tour_availability — 운영자 가용성 관리 (관리자 페이지 /admin/availability)
    //   read: 누구나 (예약 모달 캘린더에서 fetchMonthAvailability 호출)
    //   write: 어드민만 (setAvailability via /admin/availability page)
    //   구조: tour_availability/{tourId}/dates/{YYYY-MM-DD}
    //         doc 데이터: { tourId, date, status, note?, updatedAt }
    //         status: 'available' (default, doc 미생성) | 'fully_booked' | 'blackout'
    // ─────────────────────────────────────────────────────────
    match /tour_availability/{tourId}/dates/{dateId} {
      allow read:           if true;
      allow create, update: if isAdminEmail()
                            && request.resource.data.tourId is string
                            && request.resource.data.date is string
                            && request.resource.data.status in ['fully_booked', 'blackout'];
      allow delete:         if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // bookings — 톱레벨 예약 컬렉션 (capturePaypalOrder.js가 서버에서 생성)
    //   read:   본인(userEmail 매칭) 또는 어드민
    //   update/delete: 어드민만 (AdminCalendar에서 status/vehicle/driver 편집)
    //   create: 서버 전용 (Admin SDK 우회) — 어드민 수동 예약은 status='blocked' 또는 manualBooking 마킹
    // ─────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if isAdminEmail()
                    || (isSignedIn() && resource.data.userEmail == request.auth.token.email);
      allow create: if isAdminEmail()
                    && request.resource.data.createdBy == 'admin';
      allow update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // calendar_blocks — 어드민 일정 블록 (휴무/정비/마감)
    //   read/write: 어드민만
    // ─────────────────────────────────────────────────────────
    match /calendar_blocks/{blockId} {
      allow read, create, update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // booking_costs/{bookingId} — 어드민 입력 비용 (ProfitSettlement)
    //   driverFee / fuelCost / tollCost / parkingCost / mealCost / otherCost / overtimeKRW
    //   read/write: 어드민만
    // ─────────────────────────────────────────────────────────
    match /booking_costs/{bookingId} {
      allow read, create, update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // cs_tickets — 고객 서비스 이슈 트래커 (ReviewManagement CS 칸반)
    //   schema: { bookingId, customer, issue, priority, status, notes, createdAt, resolvedAt }
    //   priority: 'low' | 'medium' | 'high' | 'critical'
    //   status:   'open' | 'in_progress' | 'resolved'
    //   read/write: 어드민만
    // ─────────────────────────────────────────────────────────
    match /cs_tickets/{ticketId} {
      allow read, create, update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // drivers — 등록된 기사 명단 (Telegram chat_id를 doc ID로 사용)
    //   read/write: 어드민만 (콘솔 또는 봇으로 등록)
    // ─────────────────────────────────────────────────────────
    match /drivers/{chatId} {
      allow read, create, update, delete: if isAdminEmail();
    }

    // ─────────────────────────────────────────────────────────
    // dispatch_messages — 배차 메시지 감사 로그
    //   서버(Telegram webhook + Admin SDK)가 작성. 클라이언트는 read만.
    // ─────────────────────────────────────────────────────────
    match /dispatch_messages/{msgId} {
      allow read: if isAdminEmail();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // chat_sessions — 양방향 고객 채팅 세션 + 메시지
    //   read/write: 어드민만 (서버 SDK는 rules 우회)
    //   고객 ChatWidget은 /api/chat-poll 통해 폴링 — Firestore 직접 접근 안 함
    // ─────────────────────────────────────────────────────────
    match /chat_sessions/{sessionId} {
      allow read, write: if isAdminEmail();
      match /messages/{msgId} {
        allow read, write: if isAdminEmail();
      }
    }

    // ─────────────────────────────────────────────────────────
    // inquiry_messages — Telegram message_id ↔ chat_sessions sessionId 매핑
    //   서버 전용 (Admin SDK)
    // ─────────────────────────────────────────────────────────
    match /inquiry_messages/{msgId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // 서버 전용 컬렉션 (Admin SDK가 rules 우회)
    //   클라이언트는 접근 불가
    // ─────────────────────────────────────────────────────────
    match /used_paypal_orders/{orderId} { allow read, write: if false; }
    match /api_stats/{document=**}      { allow read, write: if false; }
    match /availability/{date}          { allow read, write: if false; }
    match /reservations/{id}            { allow read, write: if false; }
    match /chat_rate_limits/{key}       { allow read, write: if false; }
    // PR #429 (Audit WC10): submit-plan-complaint IP rate limit bucket.
    match /complaint_rate_limits/{key}  { allow read, write: if false; }
    // PR #432 (Audit W-H13): manual-payment-request IP rate limit bucket.
    match /manual_payment_rate_limits/{key} { allow read, write: if false; }
    // PR #436 (Audit Y-H8): booking-processor failure retry queue.
    match /pending_processor_retries/{orderID} { allow read, write: if false; }
    // PR #439 (Audit Z-H16): customer email failure retry queue.
    match /pending_email_retries/{retryId} { allow read, write: if false; }
    // K Tier 2-E: 텔레그램 에러 dedup + 집계 (Admin SDK 만 접근, 사용자 미노출)
    match /error_log/{logId}            { allow read, write: if false; }
    match /telegram_throttle/{key}      { allow read, write: if false; }

    // ─────────────────────────────────────────────────────────
    // 2026-05-06: PayPal Manual QR 결제 시스템
    // pending_bookings — 한국 체류 외국인 사용자가 PayPal QR 결제 후 신고
    //   read:   본인 customerEmail 일치 또는 admin
    //   create: 서버 전용 (/api/manual-payment-request, Admin SDK 우회)
    //   update: 서버 전용 (/api/admin-booking-action)
    //   delete: admin 만
    // admin_actions — 운영자 액션 audit log
    //   서버 전용 (Admin SDK)
    // ─────────────────────────────────────────────────────────
    match /pending_bookings/{bookingRef} {
      allow read: if isAdminEmail()
                  || (isSignedIn() && resource.data.customerEmail == request.auth.token.email);
      allow create, update: if false;
      allow delete: if isAdminEmail();
    }
    match /admin_actions/{actionId}     { allow read: if isAdminEmail(); allow write: if false; }

    // 2026-05-06: PayPal Webhook 자동 매칭 audit log (transmission-id keyed)
    //   서버 전용 (Admin SDK), admin 만 읽기
    match /paypal_webhook_log/{eventId} { allow read: if isAdminEmail(); allow write: if false; }

    // ─────────────────────────────────────────────────────────
    // 명시되지 않은 모든 경로는 기본 거부 (catch-all 제거!)
    // ─────────────────────────────────────────────────────────
  }
}
