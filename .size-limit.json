[
  {
    "name": "Main bundle (eager — first paint critical, all index-* chunks)",
    "path": "dist/assets/index-*.js",
    "limit": "260 KB",
    "gzip": true
  },
  {
    "name": "Vendor: Firebase Core (auth)",
    "path": "dist/assets/vendor-firebase-core-*.js",
    "limit": "40 KB",
    "gzip": true
  },
  {
    "name": "Vendor: Firebase Firestore (2026-05 PR-F charter wizard 추가로 115→120 KB, 안전 마진 3 kB)",
    "path": "dist/assets/vendor-firebase-firestore-*.js",
    "limit": "120 KB",
    "gzip": true
  },
  {
    "name": "Vendor: React (eager — react + react-dom + react-router-dom)",
    "path": "dist/assets/vendor-react-*.js",
    "limit": "80 KB",
    "gzip": true
  },
  {
    "name": "Vendor: Icons (lucide-react)",
    "path": "dist/assets/vendor-icons-*.js",
    "limit": "20 KB",
    "gzip": true
  },
  {
    "name": "Vendor: Motion (framer-motion)",
    "path": "dist/assets/vendor-motion-*.js",
    "limit": "55 KB",
    "gzip": true
  },
  {
    "name": "html2pdf (lazy — PDF download only)",
    "path": "dist/assets/html2pdf-*.js",
    "limit": "300 KB",
    "gzip": true
  }
]
