{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "puppeteerScript": "./scripts/lighthouse-preview-auth.cjs",
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.5 }],
        "categories:seo": ["warn", { "minScore": 0.5 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],
        "errors-in-console": ["warn", { "minScore": 0.9 }],
        "color-contrast": ["warn", { "minScore": 0.9 }],
        "uses-rel-preconnect": "off",
        "uses-text-compression": "off",
        "csp-xss": "off",
        "bf-cache": "off",
        "third-party-cookies": "off",
        "is-crawlable": "off",
        "image-delivery-insight": "off",
        "lcp-discovery-insight": "off",
        "network-dependency-tree-insight": "off",
        "prioritize-lcp-image": "off",
        "total-byte-weight": "off",
        "uses-passive-event-listeners": "off",
        "unused-css-rules": "off",
        "unused-javascript": "off",
        "uses-responsive-images": "off"
      }
    }
  }
}
